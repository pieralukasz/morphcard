{
  "name": "morphcard",
  "version": "0.1.0",
  "description": "A card that expands into a full detail screen and collapses back, with shared-element choreography. Framework-agnostic, zero dependencies, Web Animations API.",
  "keywords": [
    "animation",
    "shared-element",
    "morph",
    "card",
    "transition",
    "web-animations",
    "flip",
    "react"
  ],
  "homepage": "https://morphcard.lucaspiera.com",
  "bugs": "https://github.com/pieralukasz/morphcard/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pieralukasz/morphcard.git"
  },
  "license": "MIT",
  "author": "Łukasz Piera (https://lucaspiera.com)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && tsdown -c tsdown.fixtures.config.ts && playwright test",
    "serve": "node scripts/serve.mjs",
    "check:package": "publint",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "publint": "^0.3.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.4.2"
}
